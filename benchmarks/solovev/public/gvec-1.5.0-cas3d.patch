 # === Main function === #
+
+
+def _set_boozer_position_frame(ev, winding):
+    # The Fourier reconstruction uses zeta_B, so both volume and exact-edge
+    # positions must be rotated by that same angle.
+    x = ev.pos.sel(xyz="x")
+    y = ev.pos.sel(xyz="y")
+    dims = ev.pos.sel(xyz="z").dims
+    ev["xhat"] = (np.cos(winding * ev.zeta_B) * x + np.sin(winding * ev.zeta_B) * y).transpose(*dims)
+    ev["yhat"] = (-np.sin(winding * ev.zeta_B) * x + np.cos(winding * ev.zeta_B) * y).transpose(*dims)
+    ev["zhat"] = ev.pos.sel(xyz="z")
+    ev["winding"] = xr.DataArray(winding, attrs=dict(long_name="signed winding number", symbol="w"))
+    for i in "xyz":
+        ev[f"{i}hat"].attrs = dict(long_name=f"field periodic {i}-coordinate", symbol=rf"\hat{{{i}}}")
+
+
+def _boundary_flux_slopes(state: State, flip: Literal["pol", "tor"]) -> tuple[float, float]:
+    if flip not in ["pol", "tor"]:
+        raise ValueError(f"Invalid flip option: {flip}. Expected 'pol' or 'tor'.")
+    slopes = {}
+    for quantity in ["Phi", "chi"]:
+        values = np.asarray(
+            state.evaluate_rho2_profile(quantity, np.array([1.0]), deriv=1),
+            dtype=np.float64,
+        )
+        if values.shape != (1,) or not np.isfinite(values[0]):
+            raise ValueError(f"Nonfinite boundary derivative for {quantity}.")
+        slopes[quantity] = 2 * np.pi * values[0]
+    if flip == "tor":
+        slopes["Phi"] *= -1
+    else:
+        slopes["chi"] *= -1
+    return slopes["Phi"], slopes["chi"]
+
+
+def _evaluate_boundary_surface(
+    state: State,
+    MN_out: tuple[int, int],
+    MNfactor: int,
+    sampling: int,
+    winding: int,
+    reparam: bool,
+) -> xr.Dataset:
+    boundary = EvaluationsBoozer(
+        [1.0],
+        sampling * MN_out[0] + 1,
+        sampling * MN_out[1] + 1,
+        state=state,
+        radial_derivative=False,
+        MNfactor=MNfactor,
+    )
+    state.compute(boundary, "N_FP", "pos")
+    if reparam:
+        result = surface.init_surface(boundary.pos, boundary.N_FP, ift="fft", winding=winding)
+    else:
+        _set_boozer_position_frame(boundary, winding)
+        result = boundary
+    return result[["winding", "xhat", "yhat", "zhat"]]
+
+
+def _add_boundary_export(
+    output: xr.Dataset,
+    boundary: xr.Dataset,
+    state: State,
+    flip: Literal["pol", "tor"],
+    stellsym: bool,
+) -> None:
+    boundary_ft = compute.ev2ft(boundary, quiet=True).sel(m=output.m, n=output.n)
+    if stellsym:
+        coefficient_names = ["xhat_mnc", "yhat_mns", "zhat_mns"]
+    else:
+        coefficient_names = [
+            f"{name}_{suffix}" for name in ["xhat", "yhat", "zhat"] for suffix in ["mnc", "mns"]
+        ]
+    for name in coefficient_names:
+        value = boundary_ft[name].isel(rad=0, drop=True)
+        value.attrs = dict(value.attrs)
+        value.attrs["long_name"] = f"plasma-boundary {value.attrs['long_name']}"
+        value.attrs["units"] = "m"
+        output[f"boundary_{name}"] = value
+    dphi_ds, dchi_ds = _boundary_flux_slopes(state, flip)
+    output["boundary_s"] = xr.DataArray(
+        1.0,
+        attrs=dict(
+            long_name="plasma-vacuum interface radial coordinate",
+            symbol="s_b",
+            units="1",
+        ),
+    )
+    output["boundary_dPhi_ds"] = xr.DataArray(
+        dphi_ds,
+        attrs=dict(
+            long_name="boundary toroidal flux derivative",
+            symbol="dPhi/ds",
+            units="Wb",
+        ),
+    )
+    output["boundary_dchi_ds"] = xr.DataArray(
+        dchi_ds,
+        attrs=dict(
+            long_name="boundary poloidal flux derivative",
+            symbol="dchi/ds",
+            units="Wb",
+        ),
+    )
+    output.attrs["boundary_schema_version"] = 1


